# ----- World -----
locations = {
    "Fire Hall":  {"east": "Water Hall", "south": "Muddy Room"},
    "Water Hall": {"west": "Fire Hall", "east": "Air Hall", "south": "Steam Room"},
    "Air Hall":   {"west": "Water Hall", "east": "Earth Hall", "south": "Dust Room"},
    "Earth Hall": {"west": "Air Hall", "south": "Lava Room"},
    "Muddy Room": {"north": "Fire Hall"},
    "Steam Room": {"north": "Water Hall"},
    "Dust Room":  {"north": "Air Hall"},
    "Lava Room":  {"north": "Earth Hall"},  # east to Boss is unlocked later
    "Final Boss Lair": {}
}

artifacts = {
    "Water Hall": "Scroll of Water",
    "Earth Hall": "Scroll of Earth",
    "Fire Hall":  "Scroll of Fire",
    "Air Hall":   "Scroll of Air",
    "Lava Room":  "Lava Staff",
    "Steam Room": "Mist Book",
    "Dust Room":  "Dusty Sword",
}

# ----- Player state -----
backpack = []
current_location = "Fire Hall"
boss_unlocked = False

# ----- Helpers -----
def display_status():
    print(f"\nYou are in the {current_location}.")
    print(f"Inventory: {backpack or '— empty —'}")
    if current_location in artifacts and artifacts[current_location] not in backpack:
        print(f"You see a {artifacts[current_location]} here.")

def unlock_boss_if_ready():
    global boss_unlocked
    if current_location == "Lava Room" and not boss_unlocked:
        if len(backpack) == len(artifacts):
            locations["Lava Room"]["east"] = "Final Boss Lair"
            boss_unlocked = True
            print("✨ The path to the Final Boss Lair has been revealed to the east!")

def navigate(direction: str):
    direction = direction.lower()
    if direction not in {"north", "south", "east", "west"}:
        print("Use: north, south, east, or west.")
        return

    unlock_boss_if_ready()

    exits = locations.get(current_location, {})
    if direction in exits:
        global current_location
        current_location = exits[direction]
        print(f"You head {direction} to the {current_location}.")
        display_status()
        prompt_pick_up_item()
    else:
        print(f"🚫 You can’t go {direction} from {current_location}.")

def prompt_pick_up_item():
    if current_location in artifacts:
        item = artifacts[current_location]
        if item not in backpack:
            choice = input(f"Pick up the {item}? (yes/no): ").strip().lower()
            if choice == "yes":
                backpack.append(item)
                print(f"✔ You picked up the {item}.")
            else:
                print("You leave it for now.")

def show_help():
    print(
        "\nCommands:\n"
        "  north/south/east/west  move between rooms\n"
        "  inventory              show your items\n"
        "  help                   show this help\n"
        "  quit                   exit the game\n"
    )

# ----- Game loop -----
def start_adventure():
    print("Welcome to the Avatar-themed Adventure!")
    print("Collect all artifacts to unlock the Final Boss Lair in the Lava Room.")
    display_status()
    # Offer the Fire Hall item at the very beginning:
    prompt_pick_up_item()

    while current_location != "Final Boss Lair":
        cmd = input("\n> ").strip().lower()

        if cmd in {"north", "south", "east", "west"}:
            navigate(cmd)
        elif cmd == "inventory":
            print(f"Inventory: {backpack or '— empty —'}")
        elif cmd == "help":
            show_help()
        elif cmd == "quit":
            print("Goodbye, adventurer!")
            return
        elif cmd == "":
            continue
        else:
            print("I didn’t understand that. Type 'help' for commands.")

    print("\n🏆 Well done! You gathered all artifacts and reached the Final Boss Lair!")

# ----- Start -----
if __name__ == "__main__":
    start_adventure()
